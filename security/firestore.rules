// Example for the schema in plan.md. Test and migrate before deployment.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.user_id == request.auth.uid;
    }

    function unchangedOwner() {
      return request.resource.data.user_id == resource.data.user_id;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email', 'name', 'role', 'created_at'])
        && request.resource.data.keys().hasOnly(['email', 'name', 'farm_name', 'location', 'role', 'created_at'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == 'farmer'
        && request.resource.data.created_at == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'name', 'farm_name', 'location'])
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /diagnostics/{diagnosticId} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data)
        && request.resource.data.created_at == request.time;
      allow update: if owns(resource.data) && unchangedOwner()
        && request.resource.data.created_at == resource.data.created_at;
    }

    match /alerts/{alertId} {
      // A trusted server creates alerts using the Admin SDK and restricted IAM.
      allow create: if false;
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && unchangedOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    match /sensor_data/{measurementId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data)
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // Also denies unmodelled subcollections, posts and anonymous requests.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
